{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=SkillSwapLoadTestDB;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True;Max Pool Size=2000",
    "HangfireConnection": "Server=.;Database=SkillSwapLoadTestDB;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True;Max Pool Size=200",
    "Redis": ""
  },

  "JwtSettings": {
    "SecretKey": "SkillSwapAPI-LoadTest-Only-Secret-Key-0123456789",
    "Issuer": "SkillSwapAPI",
    "Audience": "SkillSwapAPI.Client",
    "ExpiryMinutes": 120,
    "RefreshExpiryDays": 7
  },

  "GmailSettings": {
    "SmtpServer": "127.0.0.1",
    "SmtpPort": 1,
    "SenderEmail": "",
    "SenderPassword": "",
    "SenderName": "SkillSwapAPI"
  },

  "Kestrel": {
    "Limits": {
      "MaxConcurrentConnections": 8000,
      "MaxConcurrentUpgradedConnections": 8000,
      "MaxRequestBodySize": 30000000
    }
  },

  "IpRateLimiting": {
    "EnableEndpointRateLimiting": false,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1s",
        "Limit": 1000000
      }
    ]
  }
}
